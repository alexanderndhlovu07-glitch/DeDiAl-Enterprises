# Public navigation and canonical origin. Use matching values for the deployment.
LANDING_URL=https://dedial-enterprises.vercel.app
APP_ORIGIN=https://dedial-platform.vercel.app
# Get these from your Supabase project settings. Use an anon/publishable key,
# NEVER a service-role/secret key. This file contains no actual credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Enable only after Google is configured in Supabase.
ENABLE_GOOGLE_AUTH=false
